# Ardeno Lead Engine
APP_ENV=local
DATABASE_URL=sqlite:///./lead_engine.db
ADMIN_API_KEY=replace-with-a-long-random-key

# Discovery and enrichment providers
GOOGLE_PLACES_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
CLEAROUT_API_KEY=

# Email sending is fail-closed for non-sandbox sends until these are valid.
SENDING_PROVIDER=sandbox
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=leads@outreach.ardeno.studio
OUTREACH_REPLY_TO=hello@ardeno.studio
OUTREACH_COMPANY_NAME=Ardeno Studio
OUTREACH_POSTAL_ADDRESS=Set a valid physical mailing address before production sending
OUTREACH_UNSUBSCRIBE_BASE_URL=http://127.0.0.1:8088/api/v1/unsubscribe
REQUIRE_DNS_AUTH=true
SENDER_DNS_AUTH_VERIFIED=false
DAILY_SEND_CAP_PER_SENDER=20
